{
  "name": "viewer3d-codespace",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python",
        "python.analysis.extraPaths": ["/workspaces/${localWorkspaceFolderBasename}/.venv/lib/python3.11/site-packages"],
        "black-formatter.args": ["--line-length", "100"],
        "notebook.scrolling.revealNextCellOnExecute": "none",
        // "python.analysis.typeCheckingMode": "basic",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true,
          "diffEditor.ignoreTrimWhitespace": false,
          "editor.defaultColorDecorators": "never",
          "editor.formatOnType": false,
          "editor.wordBasedSuggestions": "off"
        }
      }
    }
  }
}
